<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Giỏ hàng BeeBake - nguyên liệu và dụng cụ làm bánh.">
<title>Giỏ hàng | BeeBake</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600&family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&display=swap" rel="stylesheet">
<style>
:root{
  --honey:#FFC800; --honey-deep:#B88A00; --honey-soft:#FFF7D6;
  --ink:#2B2410; --ink-2:#6B6247; --line:#F1E7BE;
  --bg:#FFFFFF; --card:#FFFFFF; --sage:#3F7D5A; --sage-soft:#E8F5EC; --danger:#B3261E;
  --radius:18px; --shadow:0 1px 2px rgba(120,90,0,.06),0 12px 32px -14px rgba(184,138,0,.35);
  --font-body:"Be Vietnam Pro","Segoe UI",Roboto,Arial,sans-serif;
  --font-display:"Bricolage Grotesque","Be Vietnam Pro","Segoe UI",Arial,sans-serif;
}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth}
body{font-family:var(--font-body);background:linear-gradient(180deg,#FFFBE8 0,#FFFFFF 420px);;color:var(--ink);line-height:1.6;-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
button,input{font:inherit;color:inherit}
a{color:inherit}
:focus-visible{outline:3px solid var(--honey);outline-offset:2px;border-radius:8px}
.container{width:min(1120px,100% - 40px);margin-inline:auto}

/* Header */
.site-header{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.header-inner{display:flex;align-items:center;justify-content:space-between;height:68px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;font-family:var(--font-display);font-weight:700;font-size:1.4rem}
.brand-mark{width:36px;height:40px;display:grid;place-items:center;background:var(--honey);color:var(--ink);clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%);font-size:1.1rem}
.brand-accent{color:var(--honey-deep)}
.main-nav{display:flex;gap:6px}
.main-nav a{text-decoration:none;padding:8px 16px;border-radius:999px;font-weight:500;color:var(--ink-2);transition:background .2s}
.main-nav a:hover{background:var(--honey-soft)}
.main-nav a[aria-current=page]{background:var(--honey);color:var(--ink)}
.cart-count{display:inline-grid;place-items:center;min-width:22px;height:22px;margin-left:4px;padding:0 6px;border-radius:999px;background:var(--ink);color:#fff;font-size:.78rem;font-weight:600}

/* Heading */
.page-content{padding:44px 0 72px}
.page-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;margin-bottom:28px}
h1,h2,h3{font-family:var(--font-display);line-height:1.2}
h1{font-size:clamp(2rem,4.5vw,3rem);letter-spacing:-.02em}
.page-intro{color:var(--ink-2);margin-top:6px}
.continue-link{font-weight:500;text-decoration:none;padding:10px 18px;border:1.5px solid var(--line);border-radius:999px;transition:border-color .2s,background .2s}
.continue-link:hover{border-color:var(--honey);background:var(--honey-soft)}

/* Free shipping */
.ship-bar{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:18px 22px;margin-bottom:24px;box-shadow:var(--shadow)}
.ship-bar p{font-size:.95rem;margin-bottom:10px}
.track{height:12px;border-radius:999px;background:var(--honey-soft);overflow:hidden}
.fill{height:100%;width:0;border-radius:999px;background:linear-gradient(90deg,var(--honey),#FFD35C);transition:width .5s cubic-bezier(.3,.8,.3,1)}
.ship-bar.done .fill{background:var(--sage)}
.ship-bar.done p{color:var(--sage);font-weight:500}

/* Layout */
.cart-layout{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:28px;align-items:start}
.cart-main,.order-summary{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}
.section-heading{display:flex;justify-content:space-between;align-items:center;padding:20px 26px;border-bottom:1px solid var(--line)}
.section-heading h2{font-size:1.2rem}
.section-heading span{color:var(--ink-2);font-size:.9rem}

/* Cart item */
.cart-item{display:grid;grid-template-columns:128px 1fr auto;gap:8px 20px;padding:22px 26px;border-bottom:1px solid var(--line);align-items:center;animation:in .3s ease}
@keyframes in{from{opacity:0;transform:translateY(6px)}}
.product-image{width:128px;height:128px;object-fit:cover;border-radius:16px;background:var(--honey-soft);border:3px solid #fff;box-shadow:0 0 0 1px var(--line),0 8px 18px -8px rgba(184,138,0,.45);grid-row:span 2;display:grid;place-items:center;font-size:2.6rem}
.product-category{font-size:.78rem;color:var(--honey-deep);font-weight:600}
.product-info h3{font-size:1.1rem}
.product-variant{font-size:.88rem;color:var(--ink-2)}
.remove-link{background:none;border:0;padding:0;margin-top:4px;color:var(--ink-2);font-size:.85rem;text-decoration:underline;text-underline-offset:3px;cursor:pointer}
.remove-link:hover{color:var(--danger)}
.item-right{display:flex;flex-direction:column;align-items:flex-end;gap:10px}
.line-total{font-family:var(--font-display);font-size:1.15rem;font-weight:700}
.unit-price{font-size:.8rem;color:var(--ink-2)}
.quantity-control{display:inline-flex;align-items:center;border:1.5px solid var(--line);border-radius:999px;overflow:hidden}
.quantity-control button{width:36px;height:36px;border:0;background:none;font-size:1.15rem;cursor:pointer;transition:background .15s}
.quantity-control button:hover{background:var(--honey-soft)}
.quantity{min-width:30px;text-align:center;font-weight:600}
.cart-item:last-child{border-bottom:0}
.cart-footer{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;padding:16px 26px;background:var(--honey-soft);border-radius:0 0 var(--radius) var(--radius);font-size:.9rem}
.secure-dot{display:inline-grid;place-items:center;width:20px;height:20px;border-radius:50%;background:var(--sage);color:#fff;font-size:.7rem;margin-right:6px}
.text-button{background:none;border:0;cursor:pointer;font-weight:500;text-decoration:underline;text-underline-offset:3px}
.text-button:hover{color:var(--danger)}
.empty-state{text-align:center;padding:64px 24px}
.empty-icon{font-size:3rem;margin-bottom:8px}
.empty-state p{color:var(--ink-2);margin:6px 0 20px}
[hidden]{display:none!important}

/* Summary */
.order-summary{padding:26px;position:sticky;top:90px}
.order-summary h2{font-size:1.25rem;margin-bottom:18px}
.summary-row{display:flex;justify-content:space-between;gap:12px;padding:8px 0;font-size:.95rem}
.summary-row.discount{color:var(--sage);font-weight:500}
.muted{color:var(--ink-2)}
.coupon-form{margin:14px 0;padding:16px 0;border-block:1px dashed var(--line)}
.coupon-form label{display:block;font-weight:500;font-size:.9rem;margin-bottom:8px}
.coupon-input-row{display:flex;gap:8px}
.coupon-input-row input{flex:1;min-width:0;padding:11px 14px;border:1.5px solid var(--line);border-radius:12px;background:var(--bg);text-transform:uppercase}
.coupon-input-row input::placeholder{text-transform:none}
.coupon-input-row button{padding:0 18px;border:0;border-radius:12px;background:var(--ink);color:var(--bg);font-weight:500;cursor:pointer}
.coupon-input-row button:hover{background:var(--honey-deep);color:#fff}
.form-message{font-size:.85rem;margin-top:8px;color:var(--ink-2)}
.form-message.ok{color:var(--sage);font-weight:500}
.form-message.err{color:var(--danger)}
.summary-total{display:flex;justify-content:space-between;align-items:baseline;padding:14px 0 6px;font-weight:600}
.summary-total strong{font-family:var(--font-display);font-size:1.7rem}
.summary-note{font-size:.82rem;color:var(--ink-2);margin-bottom:18px}
.primary-button{display:inline-flex;align-items:center;justify-content:center;width:100%;padding:15px 20px;border:0;border-radius:14px;background:var(--honey);color:var(--ink);font-weight:600;font-size:1rem;text-decoration:none;cursor:pointer;box-shadow:0 6px 0 var(--honey-deep);transition:transform .12s,box-shadow .12s}
.primary-button:hover{transform:translateY(2px);box-shadow:0 4px 0 var(--honey-deep)}
.primary-button:active{transform:translateY(6px);box-shadow:0 0 0 var(--honey-deep)}
.primary-button:disabled{opacity:.45;cursor:not-allowed;transform:none;box-shadow:0 6px 0 var(--honey-deep)}
.inline-button{width:auto;padding-inline:28px}
.checkout-message{font-size:.85rem;color:var(--ink-2);margin-top:14px;min-height:1.2em}
.payment-note{display:flex;gap:10px;margin-top:14px;padding:12px 14px;border-radius:12px;background:var(--sage-soft);font-size:.82rem;color:var(--sage)}

/* Suggestions */
.suggestions{margin-top:64px}
.suggestions-head{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:20px}
.suggestions h2{font-size:1.7rem}
.suggestions-caption{color:var(--ink-2)}
.suggest-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:18px}
.suggest-card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px;display:flex;flex-direction:column;gap:6px;transition:transform .2s,box-shadow .2s}
.suggest-card:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
.sg-img{aspect-ratio:4/3;border-radius:14px;overflow:hidden;background:var(--honey-soft);display:grid;place-items:center;margin-bottom:10px;font-size:3rem}
.sg-img img{width:100%;height:100%;object-fit:cover}
.hex{width:64px;height:72px;display:grid;place-items:center;font-size:1.8rem;background:var(--honey-soft);clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%);margin-bottom:8px}
.suggest-card h3{font-size:1.05rem}
.suggest-card .price{font-weight:600;color:var(--honey-deep)}
.suggest-card button{margin-top:auto;padding:10px;border:1.5px solid var(--ink);border-radius:12px;background:none;font-weight:500;cursor:pointer;transition:background .15s,color .15s}
.suggest-card button:hover{background:var(--ink);color:var(--bg)}

/* Toast & footer */
.toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,120px);background:var(--ink);color:var(--bg);padding:12px 22px;border-radius:999px;font-size:.92rem;box-shadow:var(--shadow);transition:transform .35s cubic-bezier(.3,1.3,.5,1);z-index:50}
.toast.show{transform:translate(-50%,0)}
.site-footer{border-top:1px solid var(--line);padding:24px 0;color:var(--ink-2);font-size:.85rem}
.footer-inner{display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px}

@media (max-width:900px){
  .cart-layout{grid-template-columns:1fr}
  .order-summary{position:static}
}
@media (max-width:560px){
  .cart-item{grid-template-columns:76px 1fr;padding:18px}
  .product-image{width:96px;height:96px}
  .item-right{grid-column:1 / -1;flex-direction:row;justify-content:space-between;align-items:center}
  .section-heading,.cart-footer{padding-inline:18px}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
<body>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="#" aria-label="BeeBake - Trang chủ">
      <span class="brand-mark" aria-hidden="true">B</span>
      <span>Bee<span class="brand-accent">Bake</span></span>
    </a>
    <nav class="main-nav" aria-label="Điều hướng chính">
      <a href="#products">Sản phẩm</a>
      <a href="#cart" aria-current="page">Giỏ hàng <span class="cart-count" id="cart-count">0</span></a>
    </nav>
  </div>
</header>

<main class="container page-content">
  <div class="page-heading">
    <div>
      <h1>Giỏ hàng của bạn</h1>
      <p class="page-intro">Kiểm tra sản phẩm và số lượng trước khi thanh toán.</p>
    </div>
    <a class="continue-link" href="#products">Tiếp tục mua sắm</a>
  </div>

  <div class="ship-bar" id="ship-bar" role="status">
    <p id="ship-text"></p>
    <div class="track" aria-hidden="true"><div class="fill" id="ship-fill"></div></div>
  </div>

  <section class="cart-layout" id="cart" aria-label="Giỏ hàng">
    <div class="cart-main">
      <div class="section-heading">
        <h2>Sản phẩm đã chọn</h2>
        <span id="item-count">0 sản phẩm</span>
      </div>
      <div id="cart-list"></div>
      <div class="cart-footer" id="cart-footer">
        <p><span class="secure-dot" aria-hidden="true">✓</span>Bạn có thể kiểm tra lại đơn hàng trước khi đặt mua.</p>
        <button type="button" class="text-button" id="clear-cart">Xóa toàn bộ giỏ hàng</button>
      </div>
      <section class="empty-state" id="empty-state" hidden>
        <div class="empty-icon" aria-hidden="true">🛒</div>
        <h2>Giỏ hàng đang trống</h2>
        <p>Chọn nguyên liệu hoặc dụng cụ cho mẻ bánh tiếp theo của bạn.</p>
        <a class="primary-button inline-button" href="#products">Xem sản phẩm</a>
      </section>
    </div>

    <aside class="order-summary" aria-labelledby="summary-title">
      <h2 id="summary-title">Tóm tắt đơn hàng</h2>
      <div class="summary-row"><span>Tạm tính (<span id="summary-count">0</span> sản phẩm)</span><strong id="subtotal">0 ₫</strong></div>
      <div class="summary-row discount" id="discount-row" hidden><span>Giảm giá (BEE10)</span><strong id="discount">0 ₫</strong></div>
      <form class="coupon-form" id="coupon-form">
        <label for="coupon-code">Mã giảm giá</label>
        <div class="coupon-input-row">
          <input id="coupon-code" name="coupon" type="text" placeholder="Nhập mã ưu đãi" autocomplete="off">
          <button type="submit">Áp dụng</button>
        </div>
        <p class="form-message" id="coupon-message" aria-live="polite">Thử mã mẫu <strong>BEE10</strong> để giảm 10%.</p>
      </form>
      <div class="summary-row"><span>Phí vận chuyển</span><span class="muted" id="ship-fee">Tính ở bước tiếp theo</span></div>
      <div class="summary-total"><span>Tổng tiền hàng</span><strong id="total">0 ₫</strong></div>
      <p class="summary-note">Phí giao hàng sẽ được xác nhận khi bạn nhập địa chỉ nhận hàng.</p>
      <button class="primary-button" id="checkout-button" type="button">Tiến hành thanh toán</button>
      <p class="checkout-message" id="checkout-message" aria-live="polite"></p>
      <div class="payment-note"><span aria-hidden="true">🔒</span><p>Thông tin đơn hàng được hiển thị rõ ràng để bạn kiểm tra trước khi tiếp tục.</p></div>
    </aside>
  </section>

  <section class="suggestions" id="products" aria-labelledby="suggestions-title">
    <div class="suggestions-head">
      <h2 id="suggestions-title">Có thể bạn cũng cần</h2>
      <p class="suggestions-caption">Những món nhỏ cho lần làm bánh tiếp theo.</p>
    </div>
    <div class="suggest-grid" id="suggest-grid"></div>
  </section>
</main>

<footer class="site-footer">
  <div class="container footer-inner">
    <p>© 2026 BeeBake · Giao diện minh họa phục vụ học tập</p>
    <p>HTML5 · CSS3 · JavaScript thuần</p>
  </div>
</footer>
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
// Dữ liệu giỏ hàng lưu trong bộ nhớ trình duyệt (minh họa, không kết nối máy chủ).
const FREE_SHIP = 300000;
let cart = [
  {id:1,cat:"Nguyên liệu làm bánh",name:"Bột mì đa dụng",variant:"Quy cách: 1 kg",unit:"gói",price:45000,qty:1,img:"https://images.unsplash.com/photo-1627485937980-221c88ac04f9?auto=format&fit=crop&w=400&q=85",alt:"Bột mì trong bát và trên mặt bàn"},
  {id:2,cat:"Nguyên liệu làm bánh",name:"Socola chip",variant:"Quy cách: 200 g",unit:"gói",price:60000,qty:1,img:"https://images.unsplash.com/photo-1511381939415-e44015466834?auto=format&fit=crop&w=400&q=85",alt:"Socola dùng trong làm bánh"},
  {id:3,cat:"Dụng cụ làm bánh",name:"Khuôn bánh mini",variant:"Quy cách: 1 chiếc",unit:"chiếc",price:35000,qty:1,img:"https://images.unsplash.com/photo-1586985289688-ca3cf47d3e6e?auto=format&fit=crop&w=400&q=85",alt:"Bánh ngọt trang trí"},
  {id:4,cat:"Combo DIY",name:"Combo trang trí bánh",variant:"Bộ dụng cụ cơ bản",unit:"bộ",price:52000,qty:1,img:"https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&fit=crop&w=400&q=85",alt:"Bánh kem trang trí"}
];
const suggestions = [
  {id:11,icon:"🥚",cat:"Nguyên liệu làm bánh",name:"Bột nở (baking powder)",variant:"Quy cách: 100 g",unit:"hũ",price:22000,img:"https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=500&q=85",alt:"Bánh mì và bột làm bánh"},
  {id:12,icon:"🧈",cat:"Nguyên liệu làm bánh",name:"Bơ lạt",variant:"Quy cách: 200 g",unit:"thanh",price:48000,img:"https://images.unsplash.com/photo-1589985270826-4b7bb135bc9d?auto=format&fit=crop&w=500&q=85",alt:"Bơ lạt"},
  {id:13,icon:"🍦",cat:"Nguyên liệu làm bánh",name:"Tinh chất vani",variant:"Quy cách: 30 ml",unit:"chai",price:38000,img:"https://images.unsplash.com/photo-1486427944299-d1955d23e34d?auto=format&fit=crop&w=500&q=85",alt:"Bánh cupcake dâu"},
  {id:14,icon:"🥄",cat:"Dụng cụ làm bánh",name:"Phới đánh trứng",variant:"Inox, 1 chiếc",unit:"chiếc",price:29000,img:"https://images.unsplash.com/photo-1556910103-1c02745aae4d?auto=format&fit=crop&w=500&q=85",alt:"Dụng cụ nhà bếp"}
];
const $ = s => document.querySelector(s);
const vnd = n => new Intl.NumberFormat("vi-VN",{style:"currency",currency:"VND",maximumFractionDigits:0}).format(n);
let discountRate = 0, toastTimer;

function toast(msg){
  const t=$("#toast"); t.textContent=msg; t.classList.add("show");
  clearTimeout(toastTimer); toastTimer=setTimeout(()=>t.classList.remove("show"),2200);
}

function renderCart(){
  $("#cart-list").innerHTML = cart.map(i=>`
    <article class="cart-item" data-id="${i.id}">
      <img class="product-image" src="${i.img}" alt="${i.alt}" loading="lazy" data-icon="${i.icon||'🧁'}" onerror="this.outerHTML='<div class=&quot;product-image&quot; aria-hidden=&quot;true&quot;>'+this.dataset.icon+'</div>'">
      <div class="product-info">
        <p class="product-category">${i.cat}</p>
        <h3>${i.name}</h3>
        <p class="product-variant">${i.variant} · ${vnd(i.price)} / ${i.unit}</p>
        <button class="remove-link" type="button" data-remove aria-label="Xóa ${i.name} khỏi giỏ hàng">Xóa sản phẩm</button>
      </div>
      <div class="item-right">
        <div class="quantity-control" role="group" aria-label="Số lượng ${i.name}">
          <button type="button" data-step="-1" aria-label="Giảm số lượng ${i.name}">−</button>
          <output class="quantity" aria-live="polite">${i.qty}</output>
          <button type="button" data-step="1" aria-label="Tăng số lượng ${i.name}">+</button>
        </div>
        <div class="line-total">${vnd(i.price*i.qty)}</div>
      </div>
    </article>`).join("");
  updateSummary();
}

function updateSummary(){
  const qty = cart.reduce((s,i)=>s+i.qty,0);
  const sub = cart.reduce((s,i)=>s+i.price*i.qty,0);
  const disc = Math.round(sub*discountRate);
  const empty = cart.length===0;
  $("#item-count").textContent = `${qty} sản phẩm`;
  $("#cart-count").textContent = qty;
  $("#summary-count").textContent = qty;
  $("#subtotal").textContent = vnd(sub);
  $("#discount").textContent = "− "+vnd(disc);
  $("#discount-row").hidden = disc===0;
  $("#total").textContent = vnd(Math.max(0,sub-disc));
  $("#empty-state").hidden = !empty;
  $("#cart-list").hidden = empty;
  $("#cart-footer").hidden = empty;
  $("#checkout-button").disabled = empty;
  $("#checkout-message").textContent = "";
  const after = sub-disc, bar=$("#ship-bar");
  $("#ship-fill").style.width = Math.min(100,after/FREE_SHIP*100)+"%";
  bar.classList.toggle("done", after>=FREE_SHIP);
  $("#ship-text").textContent = empty ? `Mua từ ${vnd(FREE_SHIP)} để được miễn phí vận chuyển.`
    : after>=FREE_SHIP ? "Đơn hàng của bạn đã đủ điều kiện miễn phí vận chuyển."
    : `Mua thêm ${vnd(FREE_SHIP-after)} để được miễn phí vận chuyển.`;
}

$("#cart-list").addEventListener("click",e=>{
  const b=e.target.closest("button"); if(!b) return;
  const item=cart.find(i=>i.id===+b.closest(".cart-item").dataset.id);
  if(b.hasAttribute("data-remove")){ cart=cart.filter(i=>i!==item); toast(`Đã xóa ${item.name}`); }
  else if(b.hasAttribute("data-step")){ item.qty=Math.max(1,item.qty+ +b.dataset.step); }
  renderCart();
});

$("#clear-cart").addEventListener("click",()=>{
  cart=[]; discountRate=0; $("#coupon-code").value="";
  const m=$("#coupon-message"); m.className="form-message"; m.textContent="Giỏ hàng đã được xóa.";
  renderCart();
});

$("#coupon-form").addEventListener("submit",e=>{
  e.preventDefault();
  const code=$("#coupon-code").value.trim().toUpperCase(), m=$("#coupon-message");
  if(code==="BEE10"){ discountRate=.1; m.className="form-message ok"; m.textContent="Đã áp dụng mã BEE10: giảm 10% tiền hàng."; }
  else { discountRate=0; m.className="form-message err"; m.textContent = code ? "Mã chưa hợp lệ. Vui lòng thử BEE10." : "Vui lòng nhập mã giảm giá."; }
  updateSummary();
});

$("#checkout-button").addEventListener("click",()=>{
  $("#checkout-message").textContent="Đây là giao diện mẫu; chức năng đặt hàng thật chưa được kết nối.";
});

$("#suggest-grid").innerHTML = suggestions.map(p=>`
  <article class="suggest-card">
    <div class="sg-img"><img src="${p.img}" alt="${p.alt}" loading="lazy" data-icon="${p.icon}" onerror="this.outerHTML='<span aria-hidden=&quot;true&quot;>'+this.dataset.icon+'</span>'"></div>
    <p class="product-category">${p.cat}</p>
    <h3>${p.name}</h3>
    <p class="product-variant">${p.variant}</p>
    <p class="price">${vnd(p.price)}</p>
    <button type="button" data-add="${p.id}" aria-label="Thêm ${p.name} vào giỏ hàng">Thêm vào giỏ</button>
  </article>`).join("");

$("#suggest-grid").addEventListener("click",e=>{
  const b=e.target.closest("[data-add]"); if(!b) return;
  const p=suggestions.find(s=>s.id===+b.dataset.add);
  const exist=cart.find(i=>i.id===p.id);
  exist ? exist.qty++ : cart.push({...p,qty:1});
  renderCart(); toast(`Đã thêm ${p.name} vào giỏ hàng`);
});

renderCart();
</script>
</body>
</html>